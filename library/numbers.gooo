package numbers
namespace gooo_std_numbers
entity Integer id "gooo://std/integer"
entity Boolean id "gooo://std/boolean"

activity Min(Integer, Integer) -> Integer computes `if input0 < input1 { return input0 }; return input1`
activity Max(Integer, Integer) -> Integer computes `if input0 > input1 { return input0 }; return input1`
activity Clamp(Integer, Integer, Integer) -> Integer computes `let lower = Min(input1, input2)
let upper = Max(input1, input2)
return Max(lower, Min(input0, upper))`
activity AbsSaturating(Integer) -> Integer computes `if input == -9223372036854775808 { return 9223372036854775807 }
if input < 0 { return -input }
return input`
activity Sign(Integer) -> Integer computes `if input < 0 { return -1 }; if input > 0 { return 1 }; return 0`
activity IsZero(Integer) -> Boolean computes `return input == 0`
activity InRange(Integer, Integer, Integer) -> Boolean computes `return input0 >= Min(input1, input2) && input0 <= Max(input1, input2)`
activity NonNegative(Integer) -> Boolean computes `return input >= 0`
